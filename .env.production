# ============================================================
# AWRA Studio — Production Environment (Free Tier)
# ============================================================
# Copy this file to .env and fill in the values
# ============================================================

NODE_ENV=production
PORT=4000

# ── URLs (update after Vercel & Render deploy) ──────────────
APP_URL=https://awra-studio.vercel.app
NEXT_PUBLIC_APP_URL=https://awra-studio.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://awra-api.onrender.com/api/v1

# ── Database (from Neon or Render PostgreSQL) ───────────────
# Get from: https://neon.tech  or  https://render.com (free tier)
DATABASE_URL=postgresql://user:password@host/awra?sslmode=require

# ── Redis (from Upstash) ────────────────────────────────────
# Get from: https://upstash.com  (free tier — 10k req/day)
REDIS_URL=rediss://default:password@host:6380

# ── Auth (starter mode — no Clerk needed) ──────────────────
AUTH_PROVIDER=starter
NEXT_PUBLIC_AUTH_PROVIDER=starter
AUTH_SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_64_CHAR_RANDOM_STRING
ASSET_SIGNING_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Generate random strings with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Asset Storage (local — free, no S3 needed) ─────────────
ASSET_STORAGE_DRIVER=local
ASSET_SIGNED_URL_TTL_SECONDS=600

# ── OpenAI ─────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL_AGENT=gpt-4.1-mini
OPENAI_MODEL_SYNTHESIS=gpt-4.1-mini

# ── Stripe (optional — skip for MVP) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email / Invitations (optional) ─────────────────────────
# Get from: https://resend.com  (free: 3000 emails/month)
RESEND_API_KEY=
INVITATION_EMAIL_FROM=AWRA Studio <hello@awra.app>

# ── Crawl ──────────────────────────────────────────────────
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
CRAWL_TIMEOUT_MS=20000
CRAWL_BROWSER_TIMEOUT_MS=45000

# ── Clerk (optional — only if switching from starter auth) ─
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
